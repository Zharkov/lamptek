// Dev: SQLite. Prod: смените provider на "postgresql" и DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  title     String
  sortOrder Int        @default(0)
  // Самовложенность: «Уличное освещение» -> серия «Zenith»
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  shortDesc   String   @default("")
  fullDesc    String   @default("")
  mainImage   String   @default("")
  // Гибкие поля — набор характеристик у разных типов светильников разный.
  // JSON-строки (портируется на Postgres без боли):
  specsJson    String  @default("[]") // [{ "label": "Мощность (Вт)", "value": "180" }]
  featuresJson String  @default("[]") // ["Коэффициент пульсации < 1%", ...]
  galleryJson  String  @default("[]") // ["/uploads/x.jpg", ...]
  priceOnRequest Boolean @default(true)
  price        Int?     // в рублях, если задана цена
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String   @default("")
  comment   String   @default("")
  itemsJson String   @default("[]") // снимок корзины: [{title, slug, qty}]
  consent   Boolean  @default(false)
  status    String   @default("new") // new | called | closed
  createdAt DateTime @default(now())
}
